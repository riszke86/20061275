<%- include("partials/header", {
    pageTitle: "Contact Us"
}) %>

<main>

    <!-- ================= CONTACT HERO ================= -->

    <section class="contact-hero">
        <div class="contact-hero-content">
            <p class="section-label">
                We’re Here to Help
            </p>
            <h1>
                Contact Aquarium World
            </h1>
            <p>
                Have a question about your visit, our marine animals,
                accessibility or upcoming experiences? Send us a message
                and our team will respond as soon as possible.
            </p>
        </div>
    </section>


    <!-- ================= CONTACT SECTION ================= -->

    <section class="contact-section">
        <div class="contact-container">

            <!-- CONTACT FORM -->

            <div class="contact-form-panel">
                <p class="section-label">
                    Send Us a Message
                </p>
                <h2>
                    How can we help?
                </h2>

                <% if (messageSent) { %>

                    <div class="contact-success-message">
                        <strong>Thank you!</strong>
                        <p>Your message has been sent successfully.</p>
                    </div>

                <% } %>


                <% if (formError) { %>

                    <div class="contact-error-message">
                        <p><%= formError %></p>
                    </div>

                <% } %>

                <form 
                    class="contact-form"
                    id="contactForm"
                    method="POST"
                    action="/contact"
                >
                    <div class="form-group">
                        <label for="full-name">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="full-name"
                            name="fullName"
                            placeholder="Enter your full name"
                            value="<%= formData.fullName || '' %>"
                            required
                        >
                    </div>
                    <div class="form-group">
                        <label for="email">
                            Email Address
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email address"
                            value="<%= formData.email || '' %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="telephone">
                            Telephone
                        </label>

                        <input
                            type="tel"
                            id="telephone"
                            name="telephone"
                            placeholder="Enter your phone number"
                            value="<%= formData?.telephone || '' %>"
                        >
                    </div>

                    <div class="form-group">
                        <label for="subject">
                            Subject
                        </label>
                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            placeholder="What is your message about?"
                            value="<%= formData.subject || '' %>"
                            required
                        >

                    </div>

                    <div class="form-group">
                        <label for="message">
                            Message
                        </label>
                        <textarea
                            id="message"
                            name="message"
                            rows="7"
                            placeholder="Write your message here"
                            required
                        ><%= formData.message || '' %></textarea>

                    </div>
                    <div
                        class="contact-loader"
                        id="contactLoader"
                        aria-live="polite"
                        aria-hidden="true"
                    >
                        <div class="fish-animation">
                            <span class="loader-bubble bubble-one"></span>
                            <span class="loader-bubble bubble-two"></span>
                            <span class="loader-bubble bubble-three"></span>
                            <span class="loader-bubble bubble-four"></span>

                            <div class="fish-orbit">
                                <div class="fish-orbit-arm">
                                    <div class="fish-bob">
                                        <img
                                            src="/images/happyfish.png"
                                            alt=""
                                            class="loading-fish"
                                        >
                                    </div>
                                </div>
                            </div>

                    </div>

                    <p>Sending your message...</p>
                </div>

                <button
                    type="submit"
                    class="contact-btn"
                    id="contactSubmitButton"
                >
                    <span class="contact-button-text">
                        Send Message
                    </span>
                </button>
                </form>
            </div>


            <!-- CONTACT INFORMATION -->

            <aside class="contact-information">
                <p class="section-label">
                    Visitor Information
                </p>

                <h2>
                    Contact Details
                </h2>

                <div class="contact-information-card">
                    <h3>Email</h3>
                    <a href="mailto:info@aquariumworld.co.uk">
                        info@aquariumworld.co.uk
                    </a>
                </div>

                <div class="contact-information-card">

                    <h3>Telephone</h3>

                    <a href="tel:01908555123">
                        01908 555 123
                    </a>
                </div>

                <div class="contact-information-card">

                    <h3>Address</h3>

                    <address>
                        Aquarium World<br>
                        Ocean Way<br>
                        Milton Keynes<br>
                        MK1 1AA
                    </address>
                </div>

                <div class="contact-information-card">

                    <h3>Opening Hours</h3>

                    <p>
                        Monday–Sunday<br>
                        09:00–18:00
                    </p>
                </div>
            </aside>
        </div>
    </section>
</main>

<script src="/js/contact.js" defer></script>
<%- include("partials/footer") %>