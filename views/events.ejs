<%- include("partials/header", { pageTitle: "Special Events" }) %>

<!-- ================= EVENTS HERO ================= -->

<section class="page-hero events-hero">

    <div class="page-hero-content">

        <p class="section-label">What's On</p>

        <h1>Special Events</h1>

        <p>
            Discover talks, feeding sessions, family activities,
            conservation events and special experiences at Aquarium World.
        </p>

    </div>

</section>


<!-- ================= EVENTS ================= -->

<section class="events-section">

    <div class="section-heading">

        <p class="section-label">Plan Your Visit</p>

        <h2>What's Happening at Aquarium World</h2>

        <p class="section-introduction">
            Explore our upcoming events or discover events from previous years.
        </p>

    </div>


    <!-- ================= FILTERS ================= -->

    <div class="event-filters">

        <div class="event-filter-group">

            <label for="event-year">
                Year
            </label>

            <select id="event-year">

                <% years.forEach(item => { %>

                    <option
                        value="<%= item.year %>"
                        <%= item.year === currentYear ? "selected" : "" %>
                    >
                        <%= item.year %>
                    </option>

                <% }); %>

            </select>

        </div>


        <div class="event-filter-group">

            <label for="event-category">
                Category
            </label>

            <select id="event-category">

                <option value="all">
                    All Categories
                </option>

                <% categories.forEach(category => { %>

                    <option value="<%= category.id %>">
                        <%= category.name %>
                    </option>

                <% }); %>

            </select>

        </div>

    </div>


    <!-- ================= RESULTS INFORMATION ================= -->

    <div
        id="events-status"
        class="events-status"
        aria-live="polite"
    >
        Showing events for <strong><%= currentYear %></strong>
    </div>


    <!-- ================= EVENT CARDS ================= -->

    <div id="events-grid" class="events-grid">

        <% events.forEach(event => { %>

            <article class="event-card">

                <div class="event-image-wrapper">

                    <img
                        src="<%= event.image %>"
                        alt="<%= event.title %>"
                        class="event-image"
                    >

                </div>

                <div class="event-card-content">

                    <p class="event-category">
                        <%= event.category %>
                    </p>

                    <% if (event.is_past === 1) { %>

                        <span class="past-event-badge">
                            Past Event
                        </span>

                    <% } %>

                    <h3>
                        <%= event.title %>
                    </h3>

                    <div class="event-meta">

                        <p>
                            <strong>Date:</strong>
                            <%= event.event_date %>
                        </p>

                        <p>
                            <strong>Time:</strong>
                            <%= event.start_time %>
                            <% if (event.end_time) { %>
                                – <%= event.end_time %>
                            <% } %>
                        </p>

                        <p>
                            <strong>Location:</strong>
                            <%= event.location %>
                        </p>

                    </div>

                    <p class="event-description">
                        <%= event.short_description %>
                    </p>

                    <button
                        type="button"
                        class="event-details-button"
                        data-event-id="<%= event.id %>"
                    >
                        View Event Details
                    </button>

                </div>

            </article>

        <% }); %>

    </div>

</section>

<!-- ================= EVENT DETAILS MODAL ================= -->

<dialog id="event-details-modal" class="event-modal">

    <div class="event-modal-content">

        <button
            type="button"
            id="event-modal-close"
            class="event-modal-close"
            aria-label="Close event details"
        >
            &times;
        </button>

        <div id="event-modal-body">
            <!-- Event details are loaded here with AJAX -->
        </div>

    </div>

</dialog>

<script src="/js/events.js" defer></script>

<%- include("partials/footer") %>