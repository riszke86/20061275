<%- include("partials/header", { pageTitle: "Home" }) %>

<!-- ============== HERO SECTION ========================= -->

<section class="hero">

    <video autoplay muted loop playsinline>
        <source src="/videos/hero.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>

    <div class="hero-content">

        <h1>Explore the Ocean</h1>

        <p>
            Discover incredible marine life, immersive underwater habitats,
            and the importance of ocean conservation.
        </p>

        <a href="/zones" class="button">
            Explore Zones
        </a>

    </div>

</section>

<!-- ============== HOME INTRODUCTION ========================= -->

<section class="home-introduction">

    <div class="home-introduction-content">

        <p class="section-label">
            Plan Your Visit
        </p>

        <h2>
            Discover a World Beneath the Waves
        </h2>

        <p class="home-introduction-text">
            Step beneath the surface and discover extraordinary marine
            habitats filled with colour, movement and life. From vibrant
            coral reefs to mysterious deep-sea environments, Aquarium World
            brings visitors closer to the wonders of the ocean through
            immersive exhibits and unforgettable experiences.
        </p>

    </div>

</section>


<!-- ============== FEATURED ZONES ========================= -->

<section class="featured-zones">

    <div class="section-heading">

        <p class="section-label">
            Explore Aquarium World
        </p>

        <h2>
            Discover Our Marine Worlds
        </h2>

        <p class="section-introduction">
            Journey through four immersive habitats and discover the animals,
            environments and conservation stories found within each zone.
        </p>

    </div>

    <div class="zone-grid">

        <!-- Coral Kingdom -->

        <article class="zone-card">

            <img
                src="/images/zones/coral-kingdom.png"
                alt="Colourful tropical fish swimming around a coral reef"
            >

            <div class="zone-card-overlay"></div>

            <div class="zone-card-content">

                <p class="zone-number">
                    Zone 01
                </p>

                <h3>
                    Coral Kingdom
                </h3>

                <p>
                    Explore a vibrant reef filled with colourful fish,
                    living corals and fascinating marine relationships.
                </p>

                <a href="/zones" class="zone-link">
                    Discover this zone →
                </a>

            </div>

        </article>


        <!-- Deep Sea -->

        <article class="zone-card">

            <img
                src="/images/zones/deep-sea.png"
                alt="Deep sea creatures"
            >

            <div class="zone-card-overlay"></div>

            <div class="zone-card-content">

                <p class="zone-number">
                    Zone 02
                </p>

                <h3>
                    Deep Sea Trench
                </h3>

                <p>
                    Meet extraordinary animals adapted to life in the darkest
                    parts of the ocean.
                </p>

                <a href="/zones" class="zone-link">
                    Discover this zone →
                </a>

            </div>

        </article>


        <!-- Rock Pools -->

        <article class="zone-card">

            <img
                src="/images/zones/coastal-rockpools.png"
                alt="Coastal rock pools"
            >

            <div class="zone-card-overlay"></div>

            <div class="zone-card-content">

                <p class="zone-number">
                    Zone 03
                </p>

                <h3>
                    Coastal Rockpools
                </h3>

                <p>
                    Discover fascinating creatures living between the tides.
                </p>

                <a href="/zones" class="zone-link">
                    Discover this zone →
                </a>

            </div>

        </article>


        <!-- Rainforest -->

        <article class="zone-card">

            <img
                src="/images/zones/freshwater-rainforest.png"
                alt="Freshwater rainforest"
            >

            <div class="zone-card-overlay"></div>

            <div class="zone-card-content">

                <p class="zone-number">
                    Zone 04
                </p>

                <h3>
                    Freshwater Rainforest
                </h3>

                <p>
                    Explore tropical rivers filled with unique freshwater
                    wildlife.
                </p>

                <a href="/zones" class="zone-link">
                    Discover this zone →
                </a>

            </div>

        </article>

    </div>

</section>


<!-- ============== EXPERIENCES ========================= -->

<section class="experiences">

    <div class="section-heading">

        <p class="section-label">
            Experiences
        </p>

        <h2>
            More Than Just an Aquarium
        </h2>

    </div>

    <div class="experience-grid">

        <article class="experience-card">

            <h3>
                Shark Feeding
            </h3>

            <p>
                Watch our aquarists feed the sharks and learn about their
                behaviour.
            </p>

        </article>

        <article class="experience-card">

            <h3>
                Rock Pool Discovery
            </h3>

            <p>
                Meet fascinating coastal creatures in our interactive exhibit.
            </p>

        </article>

        <article class="experience-card">

            <h3>
                Behind the Scenes
            </h3>

            <p>
                Discover how Aquarium World cares for hundreds of marine
                animals every day.
            </p>

        </article>

    </div>

</section>


<!-- ============== OPENING TIMES ========================= -->

<section class="opening-times" id="openingTimes">

    <div class="opening-times-container">

        <!-- CURRENT VISITOR STATUS -->

        <div class="visit-status-panel">

            <div class="opening-status-badge" id="openingStatusBadge">
                <span class="status-indicator"></span>
                <span id="openingStatusText">Checking status...</span>
            </div>

            <p class="current-day" id="currentDay">
                Today
            </p>

            <h2 class="current-hours" id="currentHours">
                09:00 – 18:00
            </h2>

            <p class="last-admission">
                Last admission at 17:00
            </p>

            <div class="next-event" id="nextEvent">

                <p class="next-event-label">
                    Next event
                </p>

                <p class="next-event-details" id="nextEventDetails">
                    Loading today's schedule...
                </p>

            </div>

        </div>


        <!-- SECTION HEADING -->

        <div class="section-heading opening-times-heading">

            <p class="section-label">
                Plan Your Visit
            </p>

            <h2>
                Opening Times
            </h2>

            <p class="section-introduction">
                We are open every day. Select a day to view its scheduled
                talks, feeding sessions and marine experiences.
            </p>

        </div>


        <!-- WEEKLY OPENING TIMES -->

        <div class="opening-schedule">

            <div class="schedule-header" aria-hidden="true">
                <span>Day</span>
                <span>Open</span>
                <span>Close</span>
                <span></span>
            </div>

            <div class="schedule-days" id="scheduleDays">

                <article class="schedule-day" data-day="monday">

                    <button
                        class="schedule-day-button"
                        type="button"
                        aria-expanded="false"
                    >
                        <span class="schedule-day-name">Monday</span>
                        <span>09:00</span>
                        <span>18:00</span>
                        <span class="schedule-arrow">+</span>
                    </button>

                    <div class="day-events">
                        <div class="day-events-content">
                            <h3>Monday Events</h3>

                            <ul>
                                <li><time>10:00</time> Coral Reef Discovery Talk</li>
                                <li><time>11:30</time> Penguin Feeding</li>
                                <li><time>13:00</time> Shark Encounter</li>
                                <li><time>14:30</time> Sea Turtle Rescue Talk</li>
                                <li><time>16:00</time> Ray Lagoon Experience</li>
                            </ul>
                        </div>
                    </div>

                </article>


                <article class="schedule-day" data-day="tuesday">

                    <button
                        class="schedule-day-button"
                        type="button"
                        aria-expanded="false"
