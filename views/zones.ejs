<%- include("partials/header", { pageTitle: "Aquarium Zones" }) %>

<!-- ================= HERO ================= -->

<section class="page-hero zones-hero">

    <div class="page-hero-content">

        <p class="section-label">Explore Aquarium World</p>

        <h1>Discover Our Four Marine Zones</h1>

        <p>
            Explore four unique aquatic environments, each home to fascinating
            animals and interactive exhibits from around the world.
        </p>

    </div>

</section>


<!-- ================= ZONES ================= -->

<section class="featured-zones">

    <div class="section-heading">

        <p class="section-label">Aquarium Zones</p>

        <h2>Choose Your Adventure</h2>

        <p class="section-introduction">
            Each zone recreates a different underwater habitat and contains
            four exciting exhibits to discover.
        </p>

    </div>

    <div class="zones-grid">

    <% zones.forEach(zone => { %>

        <a href="/zones/<%= zone.route %>" class="zone-card">

            <div class="zone-image-wrapper">

                <img
                    src="<%= zone.image %>"
                    alt="<%= zone.name %> aquarium habitat"
                    class="zone-image"
                >

            </div>

            <div class="zone-content">

                <p class="zone-tag">
                    <%= zone.tag %>
                </p>

                <h3>
                    <%= zone.name %>
                </h3>

                <p>
                    <%= zone.introduction %>
                </p>

                <span class="zone-link">
                    Explore Zone →
                </span>

            </div>

        </a>

    <% }); %>

</div>

</section>

<%- include("partials/footer") %>